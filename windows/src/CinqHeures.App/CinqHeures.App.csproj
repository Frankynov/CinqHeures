<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <!-- Runs as a plain .exe that carries the Windows App SDK with it: nothing to install first. -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>5heures</Product>
    <AssemblyTitle>5heures</AssemblyTitle>
    <Description>5heures — every review by Hugues Dayez and every digression by Rudy Léonet. Unofficial.</Description>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RootNamespace>CinqHeures</RootNamespace>
    <AssemblyName>CinqHeures</AssemblyName>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- The catalogue the macOS app ships, so a first launch shows everything at once. -->
    <EmbeddedResource Include="..\..\..\Resources\Snapshot\snapshot-catalogue.json" LogicalName="snapshot-catalogue.json" />
    <EmbeddedResource Include="..\..\..\Resources\Snapshot\snapshot-films.json" LogicalName="snapshot-films.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.png" />
    <Content Include="Assets\AppIcon.ico" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- The Windows App SDK's parts this app uses, not the whole package: its AI, ML, Search and Widgets parts brought
         onnxruntime.dll and DirectML.dll, some 40 MB, to an app that plays podcasts. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <ProjectReference Include="..\CinqHeures.Core\CinqHeures.Core.csproj" />
  </ItemGroup>
</Project>
